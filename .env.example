# Copy this file to .env and fill in only what you have. Every value is optional:
# with none of them set, all three scripts run on the sample data.

# Script 1: a HubSpot private app token with the crm.objects.contacts.read scope
HUBSPOT_TOKEN=
# Optional: your Hub ID and app domain, so Slack links open the contact record
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_DOMAIN=app.hubspot.com   # use app-eu1.hubspot.com for EU portals

# Script 3: a Slack incoming webhook URL for the channel you want to post to
SLACK_WEBHOOK_URL=

# Script 3: optional, lets Claude write the digest headline
ANTHROPIC_API_KEY=
# Optional: override the model (see https://platform.claude.com/docs/en/about-claude/models/overview)
ANTHROPIC_MODEL=claude-sonnet-5-5
